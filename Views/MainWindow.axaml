<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Webtoon_Downloader.ViewModels"
        xmlns:models="using:Webtoon_Downloader.Models"
        x:Class="Webtoon_Downloader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Webtoon-Downloader"
        Width="650"
        Height="500"
        MinWidth="400"
        MinHeight="300">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="15"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <TextBox x:Name="UrlInput"
                     Grid.Column="0"
                     Watermark="웹툰 URL 입력"
                     Text="{Binding WebtoonUrl, Mode=TwoWay}"
                     KeyDown="UrlInput_KeyDown"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="확인"
                    Padding="22,8"
                    Click="ConfirmButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="6"
                    IsVisible="{Binding IsBusy}">
            
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>
            
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="8"
                         Value="{Binding Progress}"/>
        </StackPanel>

        <Grid Grid.Row="2"
              RowDefinitions="Auto,*"
              RowSpacing="8">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <TextBlock Grid.Column="0"
                           Text="웹툰 목록"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="가져오기"
                        Click="ImportWebtoons_Click"
                        Padding="12,5"/>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">

                <ListBox x:Name="WebtoonList"
                         ItemsSource="{Binding WebtoonTitles}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="5">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:StoredWebtoon">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="5">

                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        DoubleTapped="Webtoon_DoubleTapped">

                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="5"/>
                                </Border>

                                <Button Grid.Column="1"
                                        Content="삭제"
                                        Click="DeleteWebtoon_Click"
                                        Padding="12,5"/>
                            </Grid>

                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>