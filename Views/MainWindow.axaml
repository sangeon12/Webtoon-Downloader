<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Webtoon_Downloader.ViewModels"
        x:Class="Webtoon_Downloader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Webtoon-Downloader"
        Width="650"
        Height="500"
        MinWidth="400"
        MinHeight="300">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="15"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <TextBox x:Name="UrlInput"
                     Grid.Column="0"
                     Watermark="웹툰 URL 입력"
                     Text="{Binding WebtoonUrl, Mode=TwoWay}"
                     KeyDown="UrlInput_KeyDown"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="확인"
                    Padding="22,8"
                    Click="ConfirmButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="6">

            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>

            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="8"
                         Value="{Binding Progress}"
                         IsVisible="{Binding IsBusy}"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
            
            <ListBox ItemsSource="{Binding WebtoonTitles}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="5"/>
        </Border>
    </Grid>
</Window>